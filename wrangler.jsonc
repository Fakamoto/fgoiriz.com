{
    "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
    "name": "fgoiriz-agent-ready",
    "main": "worker.mjs",
    "compatibility_date": "2026-08-21",
    "workers_dev": false,
    "routes": [
        {
            "pattern": "fgoiriz.com/*",
            "zone_name": "fgoiriz.com"
        }
    ]
}
